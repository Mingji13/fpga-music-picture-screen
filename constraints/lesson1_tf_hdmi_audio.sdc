# ============================================================
# 1. Base input clock: 50 MHz
# ============================================================
create_clock -name clk -period 20.000 -waveform {0.000 10.000} \
    [get_ports {clk}]

# Automatically derive clocks generated by PLLs
derive_clocks


# ============================================================
# 2. Rename PLL output clocks
# ============================================================
rename_clock -name {sd_card_clk} \
    -source [get_ports {clk}] -master_clock {clk} \
    [get_pins {sys_pll_m0/pll_inst.clkc[0]}]

rename_clock -name {ext_mem_clk} \
    -source [get_ports {clk}] -master_clock {clk} \
    [get_pins {sys_pll_m0/pll_inst.clkc[1]}]

rename_clock -name {ext_mem_clk_sft} \
    -source [get_ports {clk}] -master_clock {clk} \
    [get_pins {sys_pll_m0/pll_inst.clkc[2]}]

rename_clock -name {video_clk} \
    -source [get_ports {clk}] -master_clock {clk} \
    [get_pins {video_pll_m0/pll_inst.clkc[0]}]

rename_clock -name {hdmi_5x_clk} \
    -source [get_ports {clk}] -master_clock {clk} \
    [get_pins {video_pll_m0/pll_inst.clkc[1]}]

# The direct PCM selector does not use the optional I2S audio_mclk.
# Synthesis removes that PLL output, so no clock is renamed for it here.


# ============================================================
# 3. Asynchronous reset and synchronizer first stages
# ============================================================
set_false_path -from [get_ports {rst_n}]

# ext_rst_n feeds only asynchronous reset pins of reset_sync instances.
# Keep their s1 -> s2 data paths timed; exclude the asynchronous reset input.
set_false_path -through [get_nets {ext_rst_n}]

# SW3/SW4 feed only mode_meta, which TD may pack into input registers.
# A path launched at either port ends at that first sampling register;
# mode_meta -> mode_sync and all following register paths remain timed.
set_false_path -from [get_ports {audio_mode_sw[0] audio_mode_sw[1]}]

# SW1 feeds only the first sampling register of u_waveform_switch.
# The synchronizer's first-to-second stage and debounce paths remain timed.
set_false_path -from [get_ports {waveform_sw}]

# SW2 and KEY4 each feed only a debounce synchronizer's first stage.
# Keep their internal synchronizer/debounce paths timed, as for SW1.
set_false_path -from [get_ports {song_order_sw key4}]

# First stage of reset_sync and sync_2ff
set_false_path -to [get_regs -hier {*/s1}]

# First stage of the write-finish toggle synchronizer
set_false_path -nowarn -to \
    [get_regs -nowarn -hier {sd_card_bmp_m0/wrfin_tgl_sync[0]}]

# First sampling stages of the optional I2S receiver.
# The runtime PCM selector leaves this optional receiver unused.
# -nowarn allows only these optional targets to be absent; when present,
# the original first-stage false paths still apply.
set_false_path -nowarn -to \
    [get_regs -nowarn -hier {u_I2S_receiver/S_i2s_bclk_1d}]

set_false_path -nowarn -to \
    [get_regs -nowarn -hier {u_I2S_receiver/S_i2s_lrck_1d}]

set_false_path -nowarn -to \
    [get_regs -nowarn -hier {u_I2S_receiver/S_i2s_dout_1d}]


# ============================================================
# 4. Intentional clock-domain crossings
#
# Bound each crossing to one source-clock period.
# This covers asynchronous FIFOs and held request/ack signals
# without disabling all CDC timing checks.
# ============================================================

# sd_card_clk 100 MHz -> ext_mem_clk 125 MHz
set_max_delay -from [get_clocks {sd_card_clk}] \
    -to [get_clocks {ext_mem_clk}] \
    10.000 -datapath_only

# ext_mem_clk 125 MHz -> sd_card_clk 100 MHz
set_max_delay -from [get_clocks {ext_mem_clk}] \
    -to [get_clocks {sd_card_clk}] \
    8.000 -datapath_only

# video_clk 74 MHz -> ext_mem_clk 125 MHz
set_max_delay -from [get_clocks {video_clk}] \
    -to [get_clocks {ext_mem_clk}] \
    13.514 -datapath_only

# ext_mem_clk 125 MHz -> video_clk 74 MHz
set_max_delay -from [get_clocks {ext_mem_clk}] \
    -to [get_clocks {video_clk}] \
    8.000 -datapath_only

# display_valid and other stable SD-domain status signals
set_max_delay -from [get_clocks {sd_card_clk}] \
    -to [get_clocks {video_clk}] \
    10.000 -datapath_only

# state_code displayed by the 50 MHz seven-segment circuit
set_max_delay -from [get_clocks {sd_card_clk}] \
    -to [get_clocks {clk}] \
    10.000 -datapath_only

# Frame commits / transition acknowledgements return through SD-domain
# two-stage synchronizers; the display index is also sampled at 50 MHz.
set_max_delay -from [get_clocks {video_clk}] \
    -to [get_clocks {sd_card_clk}] \
    13.514 -datapath_only

set_max_delay -from [get_clocks {video_clk}] \
    -to [get_clocks {clk}] \
    13.514 -datapath_only


# ============================================================
# 5. HDMI ODDR-to-output path
# ============================================================
# The shared symbol-toggle first stage samples the serial FALLING edge.
# These PLL clocks are related: naturally check video -> falling serial
# (2.027 ns nominal) and falling -> rising serial (1.351 ns nominal).
# No max-delay or false-path exception applies to either toggle stage.

# Pixel words remain stable for five serial clocks. Capture is on edge 4;
# these exceptions apply ONLY to the pixel-word load, not serial shifts.
set_multicycle_path -setup -end -from [get_clocks {video_clk}] \
    -to [get_regs -hier {*/S_shift_data[*]}] 4
set_multicycle_path -hold -end -from [get_clocks {video_clk}] \
    -to [get_regs -hier {*/S_shift_data[*]}] 3

set_max_delay -from [get_clocks {hdmi_5x_clk}] \
    -to [get_ports {HDMI_CLK_P HDMI_D0_P HDMI_D1_P HDMI_D2_P}] \
    2.702 -datapath_only


# ============================================================
# 6. Hold-time margin
# ============================================================
set_clock_uncertainty -hold 0.050 \
    [get_clocks {
        clk
        sd_card_clk
        ext_mem_clk
        ext_mem_clk_sft
        video_clk
        hdmi_5x_clk
    }]


# ============================================================
# 7. SDRAM main clock and phase-shifted output clock
# ============================================================
set_false_path -from [get_clocks {ext_mem_clk}] \
    -to [get_clocks {ext_mem_clk_sft}]

set_false_path -from [get_clocks {ext_mem_clk_sft}] \
    -to [get_clocks {ext_mem_clk}]

